# ==========================================
# GitLab CI/CD Dashboard - Environment Configuration
# ==========================================
# ⚠️  SECURITY WARNING: DO NOT use these example values in production!

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=gitlab_dashboard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=gitlab_dashboard

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ==========================================
# App Configuration
# ==========================================
NODE_ENV=production
# Published port: PORT (all interfaces), IPV4:PORT or [IPV6]:PORT.
# Use 127.0.0.1:3000 to expose it only to a reverse proxy on the same host.
DASHBOARD_PORT=3000

# ==========================================
# Admin User (Auto-created on first run)
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com

# ==========================================
# Security
# ==========================================
# Generate a random 64-character secret key
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_64_CHARS_MINIMUM

# Optional: encrypts GitLab access tokens stored in the database (AES-256-GCM).
# Strongly recommended. If unset, tokens are stored in plain text.
# Generate with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX_STRING

# ==========================================
# GitLab Webhook (Optional)
# ==========================================
# Authenticates GitLab webhook requests (X-Gitlab-Token header). If unset,
# webhooks on the install-wide URL are accepted without authentication.
# Per-organization webhook secrets are derived from it, so changing it
# breaks existing webhooks. Generate with: openssl rand -hex 32
GITLAB_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ==========================================
# Outside Docker Compose only
# ==========================================
# docker-compose.yml builds these from the values above. Set them only when
# running the app directly (npm run start / npm run dev).
# DATABASE_URL=postgresql://gitlab_dashboard:PASSWORD@localhost:5432/gitlab_dashboard?schema=public
# REDIS_URL=redis://:PASSWORD@localhost:6379
# Alternative to REDIS_URL:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Deprecated: LICENSE_ENCRYPTION_KEY is still read when TOKEN_ENCRYPTION_KEY
# is unset, but docker-compose.yml does not pass it. Older installs that set
# it must copy its value to TOKEN_ENCRYPTION_KEY to keep stored tokens readable.

# ==========================================
# GitLab CI/CD Dashboard - Environment Configuration
# ==========================================
# ⚠️  SECURITY WARNING: DO NOT use these example values in production!

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=gitlab_dashboard
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=gitlab_dashboard

# ==========================================
# Redis Configuration
# ==========================================
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ==========================================
# App Configuration
# ==========================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Admin User (Auto-created on first run)
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@example.com

# ==========================================
# Security
# ==========================================
# Generate a random 64-character secret key
SESSION_SECRET=CHANGE_ME_RANDOM_SECRET_KEY_64_CHARS_MINIMUM

# ==========================================
# GitLab Webhook (Optional)
# ==========================================
# Secret token for validating GitLab webhook requests
# Set the same value in GitLab webhook settings
GITLAB_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ==========================================
# License Configuration (Optional)
# ==========================================
# JWT license key from your SaaS dashboard
# Without a license key, the dashboard runs in free tier (3 projects, 1 user)
# LICENSE_KEY=eyJhbGciOiJSUzI1NiIs...

# Encryption key for license keys stored in database (AES-256-GCM)
# Generate with: openssl rand -hex 32
# LICENSE_ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX_STRING

# RSA public key for offline license verification
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBI..."

# SaaS URL for online license validation (optional, enables revocation checks)
# LICENSE_VERIFICATION_URL=https://your-saas-domain.com

# URL shown in upgrade banners
# NEXT_PUBLIC_LICENSE_URL=https://your-saas-domain.com/pricing

# Set to "true" to hide the free tier license banner
# NEXT_PUBLIC_HIDE_LICENSE_BANNER=false

# ==========================================
# Cloud Mode (Multi-Tenant SaaS)
# ==========================================
# Set AUTH_MODE to 'supabase' to enable cloud/multi-tenant mode.
# In self-hosted mode (default), leave this unset or set to 'session'.
# AUTH_MODE=session

# Supabase credentials (required when AUTH_MODE=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJSUzI1NiIs...

# Supabase anon key (required when AUTH_MODE=supabase, used by browser client)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Auth mode indicator for client-side (must match AUTH_MODE)
# NEXT_PUBLIC_AUTH_MODE=supabase

# Cloud webhook secret for receiving provisioning events from the SaaS platform
# Must match CLOUD_WEBHOOK_SECRET on the web platform side
# CLOUD_WEBHOOK_SECRET=CHANGE_ME_CLOUD_WEBHOOK_SECRET

# Encryption key for GitLab tokens stored in database (AES-256-GCM)
# Generate with: openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=CHANGE_ME_RANDOM_HEX_STRING
